@model List<PersonalCabinet.Models.Application>
@{
    ViewData["Title"] = "Мои заявки";
}
<link rel="stylesheet" href="/css/index.css" />

<div class="page-title"><i class="bi bi-file-earmark-text"></i> Мои заявки</div>
<div class="mb-3">
    <a href="/Application/Create" class="btn-cabinet"><i class="bi bi-plus-circle"></i> Новая заявка</a>
</div>

<div class="card-cabinet mb-4">
    <div class="card-header">Фильтрация заявок</div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label-cabinet">Статус</label>
                <select name="statusFilter" class="form-control-cabinet">
                    <option value="">Все</option>
                    <option value="Draft" selected="@(ViewBag.CurrentStatusFilter == "Draft")">Черновик</option>
                    <option value="Submitted" selected="@(ViewBag.CurrentStatusFilter == "Submitted")">Подана</option>
                    <option value="InReview" selected="@(ViewBag.CurrentStatusFilter == "InReview")">На рассмотрении</option>
                    <option value="Approved" selected="@(ViewBag.CurrentStatusFilter == "Approved")">Одобрена</option>
                    <option value="Rejected" selected="@(ViewBag.CurrentStatusFilter == "Rejected")">Отклонена</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatusFilter == "Completed")">Завершена</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label-cabinet">Поиск (№, название, адрес)</label>
                <input type="text" name="searchString" class="form-control-cabinet" value="@ViewBag.CurrentSearchString" placeholder="Введите текст..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn-cabinet w-100">Применить</button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a href="@Url.Action("Index")" class="btn-cabinet-outline w-100">Сбросить</a>
            </div>
        </form>
    </div>
</div>

<div class="card-cabinet">
    <div class="card-header">Список заявок</div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
                <table class="table-cabinet">
                    <thead>
                        <tr>
                            <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.NumberSortParam, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="sort-link">№ заявки ⇅</a></th>
                            <th>Название</th>
                            <th>Адрес</th>
                            <th>Мощность</th>
                            <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.DateSortParam, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="sort-link">Дата ⇅</a></th>
                            <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.StatusSortParam, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="sort-link">Статус ⇅</a></th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var app in Model)
                    {
                                <tr>
                                    <td>@app.ApplicationNumber</td>
                                    <td>@app.Title</td>
                                    <td>@app.ObjectAddress</td>
                                    <td>@(app.RequestedPower?.ToString("0.##") ?? "—") кВт</td>
                                    <td>@(app.SubmittedAt?.ToString("dd.MM.yyyy") ?? app.CreatedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td>
                                @{
                                    string statusRu = app.Status switch
                                    {
                                        "Draft" or "NEW" => "Черновик",
                                        "Submitted" => "Подана",
                                        "InReview" or "IN_REVIEW" => "На рассмотрении",
                                        "Approved" or "APPROVED" => "Одобрена",
                                        "Rejected" or "REJECTED" => "Отклонена",
                                        "Completed" or "COMPLETED" => "Завершена",
                                        _ => app.Status
                                    };
                                    string badgeClass = statusRu switch
                                    {
                                        "Черновик" => "badge-draft",
                                        "Подана" => "badge-submitted",
                                        "На рассмотрении" => "badge-inreview",
                                        "Одобрена" => "badge-approved",
                                        "Отклонена" => "badge-rejected",
                                        "Завершена" => "badge-submitted",
                                        _ => "badge-draft"
                                    };
                                }
                                        <span class="badge-status @badgeClass">@statusRu</span>
                                    </td>
                                    <td>
                                        <a href="/Application/Details/@app.Id" class="btn-cabinet-outline btn-sm"><i class="bi bi-eye"></i> Просмотр</a>
                                @if (app.Status == "Draft" || app.Status == "Rejected" || app.Status == "NEW" || app.Status == "REJECTED")
                                {
                                                <a href="/Application/Edit/@app.Id" class="btn-cabinet-outline btn-sm"><i class="bi bi-pencil"></i> Редактировать</a>
                                                <a href="/Application/Delete/@app.Id" class="btn-cabinet-outline btn-sm text-danger"><i class="bi bi-trash"></i> Удалить</a>
                                }
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>

                <div class="pagination-container">
                @if (ViewBag.TotalCount > ViewBag.PageSize)
                {
                    int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
                    for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == ViewBag.CurrentPage)
                        {
                                            <span class="btn-cabinet-outline btn-sm disabled">@i</span>
                        }
                        else
                        {
                                            <a href="@Url.Action("Index", new { page = i, sortOrder = ViewBag.CurrentSort, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="btn-cabinet-outline btn-sm">@i</a>
                        }
                    }
                }
                </div>
        }
        else
        {
                <div class="text-center p-5">Нет заявок, соответствующих условиям</div>
        }
    </div>
</div>