@model List<PersonalCabinet.Models.Application>
@{
    ViewData["Title"] = "Мои заявки";
}
<link rel="stylesheet" href="/css/index.css" />

<div class="page">
    <div class="header">
        <h1><i class="bi bi-file-earmark-text"></i> Мои заявки</h1>
    </div>

    <div class="card">
        <h2>Фильтрация заявок</h2>
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Статус</label>
                <select name="statusFilter" class="form-control">
                    <option value="">Все</option>
                    <option value="Draft" selected="@(ViewBag.CurrentStatusFilter == "Draft")">Черновик</option>
                    <option value="Submitted" selected="@(ViewBag.CurrentStatusFilter == "Submitted")">Подана</option>
                    <option value="InReview" selected="@(ViewBag.CurrentStatusFilter == "InReview")">На рассмотрении</option>
                    <option value="Approved" selected="@(ViewBag.CurrentStatusFilter == "Approved")">Одобрена</option>
                    <option value="Rejected" selected="@(ViewBag.CurrentStatusFilter == "Rejected")">Отклонена</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatusFilter == "Completed")">Завершена</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Поиск (№, название, адрес, организация)</label>
                <input type="text" name="searchString" class="form-control" value="@ViewBag.CurrentSearchString" placeholder="Введите текст..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn-create w-100">Применить</button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a href="@Url.Action("Index")" class="btn-link-all w-100">Сбросить</a>
            </div>
        </form>
    </div>

    <div class="card">
        <h2>Список заявок</h2>
        @if (Model.Any())
        {
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.NumberSortParam, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="sort-link">№ заявки ⇅</a></th>
                                <th>Название</th>
                                <th>Заявитель</th>
                                <th>Тип заявителя</th>
                                <th>Адрес</th>
                                <th>Мощность</th>
                                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.DateSortParam, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="sort-link">Дата ⇅</a></th>
                                <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.StatusSortParam, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="sort-link">Статус ⇅</a></th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var app in Model)
                        {
                              <tr>
                                <td>@app.ApplicationNumber</td>
                                   <td>@app.Title</td>
                                     <td>
                                            <td>
                                        @if (app.ApplicantType == "INDIVIDUAL")
                                        {
                                            var fullName = $"{app.LastName} {app.FirstName} {app.MiddleName}".Trim();
                                            if (!string.IsNullOrEmpty(fullName))
                                            {
                                                @fullName
                                            }
                                            else
                                            {
                                                @(app.User?.Email ?? "—")
                                            }
                                        }
                                        else if (app.ApplicantType == "ORGANIZATION")
                                        {
                                            @(app.OrganizationShortName ?? app.OrganizationFullName ?? app.User?.Email ?? "—")
                                        }
                                        else
                                        {
                                            @(app.User?.Email ?? "—")
                                        }
                             </td>
                        </td>
                   <td>
                                    @(app.ApplicantType == "INDIVIDUAL" ? "Физ. лицо" :
                                          app.ApplicantType == "ORGANIZATION" ? "Организация" : "—")
                                        </td>
                                        <td>@app.ObjectAddress</td>
                                        <td>@(app.RequestedPower?.ToString("0.##") ?? "—") кВт</td>
                                        <td>@(app.SubmittedAt?.ToString("dd.MM.yyyy") ?? app.CreatedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                                        <td>
                                    @{
                                        string statusRu = app.Status switch
                                        {
                                            "Draft" or "NEW" => "Черновик",
                                            "Submitted" => "Подана",
                                            "InReview" or "IN_REVIEW" => "На рассмотрении",
                                            "Approved" or "APPROVED" => "Одобрена",
                                            "Rejected" or "REJECTED" => "Отклонена",
                                            "Completed" or "COMPLETED" => "Завершена",
                                            _ => app.Status
                                        };
                                        string badgeClass = statusRu switch
                                        {
                                            "Черновик" => "badge-gray",
                                            "Подана" => "badge-yellow",
                                            "На рассмотрении" => "badge-blue",
                                            "Одобрена" => "badge-green",
                                            "Отклонена" => "badge-red",
                                            "Завершена" => "badge-green",
                                            _ => "badge-gray"
                                        };
                                    }
                                            <span class="badge @badgeClass">@statusRu</span>
                                        </td>
                                        <td>
                                            <a href="/Application/Details/@app.Id" class="btn-small"><i class="bi bi-eye"></i> Просмотр</a>
                                    @if (app.Status == "Draft" || app.Status == "Rejected" || app.Status == "NEW" || app.Status == "REJECTED")
                                    {
                                                    <a href="/Application/Edit/@app.Id" class="btn-small"><i class="bi bi-pencil"></i> Редактировать</a>
                                                    <a href="/Application/Delete/@app.Id" class="btn-small text-danger"><i class="bi bi-trash"></i> Удалить</a>
                                    }
                                        </td>
                                    </tr>
                        }
                        </tbody>
                    </table>
                </div>

            @if (ViewBag.TotalCount > ViewBag.PageSize)
            {
                        <div class="text-right" style="margin-top: 20px;">
                    @{
                        int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
                        for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                                    <span class="btn-small disabled">@i</span>
                            }
                            else
                            {
                                                    <a href="@Url.Action("Index", new { page = i, sortOrder = ViewBag.CurrentSort, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString })" class="btn-small">@i</a>
                            }
                        }
                    }
                        </div>
            }
        }
        else
        {
                <div class="empty">
                    <i class="bi bi-inbox"></i>
                    <p>Нет заявок, соответствующих условиям</p>
                    <a href="/Application/Create" class="btn-create">Создать первую заявку</a>
                </div>
        }
    </div>
</div>