@model PersonalCabinet.Models.Application
@{
    ViewData["Title"] = "Удаление заявки";
}
<div class="page-title"><i class="bi bi-trash"></i> Удаление заявки</div>
<div class="card-cabinet text-center p-4">
    <i class="bi bi-exclamation-triangle" style="font-size:48px;color:#c62828;"></i>
    <h4>Удалить заявку ?@Model.ApplicationNumber?</h4>
    <p>Это действие необратимо.</p>
    <form method="post" asp-action="DeleteConfirmed">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn-cabinet btn-danger">Да, удалить</button>
        <a href="/Application/Details/@Model.Id" class="btn-cabinet-outline">Отмена</a>
    </form>
</div>