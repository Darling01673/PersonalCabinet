@model PersonalCabinet.Models.User
@{
    ViewData["Title"] = "Пользователь " + Model.Email;
}
<link rel="stylesheet" href="/css/mainmenu.css" />

<div class="page">
    <div class="header">
        <h1><i class="bi bi-person"></i> Пользователь @Model.Email</h1>
        <p>Просмотр и управление учётной записью</p>
    </div>

    <div class="card">
        <h2>Основные данные</h2>
        <div class="card-body">
            <div class="row mb-2"><div class="col-3 fw-bold">ID:</div><div class="col-9">@Model.Id</div></div>
            <div class="row mb-2"><div class="col-3 fw-bold">Email:</div><div class="col-9">@Model.Email</div></div>
            <div class="row mb-2"><div class="col-3 fw-bold">Телефон:</div><div class="col-9">@(Model.Phone ?? "—")</div></div>
            <div class="row mb-2"><div class="col-3 fw-bold">Роль:</div><div class="col-9">@Model.Role</div></div>
            <div class="row mb-2"><div class="col-3 fw-bold">Тип:</div><div class="col-9">@Model.UserType</div></div>
            <div class="row mb-2"><div class="col-3 fw-bold">Дата регистрации:</div><div class="col-9">@(Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div></div>
            <div class="row mb-2"><div class="col-3 fw-bold">Последнее обновление:</div><div class="col-9">@(Model.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div></div>
        </div>
    </div>

    @if (Model.IndividualProfile != null)
    {
        <div class="card mt-4">
            <h2>Профиль физического лица</h2>
            <div class="card-body">
                <div class="row mb-2"><div class="col-3 fw-bold">ФИО:</div><div class="col-9">@Model.IndividualProfile.LastName @Model.IndividualProfile.FirstName @Model.IndividualProfile.MiddleName</div></div>
            </div>
        </div>
    }

    @if (Model.OrganizationProfile != null)
    {
        <div class="card mt-4">
            <h2>Профиль организации</h2>
            <div class="card-body">
                <div class="row mb-2"><div class="col-3 fw-bold">Полное наименование:</div><div class="col-9">@Model.OrganizationProfile.FullName</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Краткое наименование:</div><div class="col-9">@(Model.OrganizationProfile.ShortName ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Контактное лицо:</div><div class="col-9">@(Model.OrganizationProfile.ContactPerson ?? "—")</div></div>
            </div>
        </div>
    }

    @if (Model.PersonalData != null)
    {
        <div class="card mt-4">
            <h2>Дополнительные персональные данные</h2>
            <div class="card-body">
                <div class="row mb-2"><div class="col-3 fw-bold">Место жительства:</div><div class="col-9">@(Model.PersonalData.ResidenceAddress ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">ИНН:</div><div class="col-9">@(Model.PersonalData.Inn ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Паспорт:</div><div class="col-9">@(Model.PersonalData.PassportSeries) @(Model.PersonalData.PassportNumber)</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Дата выдачи:</div><div class="col-9">@(Model.PersonalData.PassportDate?.ToString("dd.MM.yyyy") ?? "—")</div></div>
            </div>
        </div>
    }

    <div class="mt-3 d-flex gap-2">
        <a href="@Url.Action("Users")" class="btn-cabinet-outline"><i class="bi bi-arrow-left"></i> Назад к списку</a>
        <button type="button" class="btn-cabinet" id="resetPasswordBtn"><i class="bi bi-key"></i> Сбросить пароль</button>
    </div>
</div>
<div id="passwordModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
             Сброс пароля пользователя
        </div>
        <div class="modal-body">
            <p>Вы собираетесь изменить пароль для <strong>@Model.Email</strong>.</p>
            <div class="form-group">
                <label class="form-label">Новый пароль</label>
                <input type="password" id="newPassword" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Подтверждение пароля</label>
                <input type="password" id="confirmPassword" class="form-control" />
            </div>
            <div id="passwordError" class="text-danger" style="display:none;"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cabinet-outline" id="cancelPasswordBtn">Отмена</button>
            <button type="button" class="btn-cabinet" id="confirmPasswordBtn">Сохранить</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('passwordModal');
        const resetBtn = document.getElementById('resetPasswordBtn');
        const cancelBtn = document.getElementById('cancelPasswordBtn');
        const confirmBtn = document.getElementById('confirmPasswordBtn');
        const newPwd = document.getElementById('newPassword');
        const confirmPwd = document.getElementById('confirmPassword');
        const errorDiv = document.getElementById('passwordError');

        function showError(msg) {
            errorDiv.textContent = msg;
            errorDiv.style.display = 'block';
        }
        function hideError() {
            errorDiv.style.display = 'none';
        }
        function openModal() {
            modal.classList.add('active');
            newPwd.value = '';
            confirmPwd.value = '';
            hideError();
        }
        function closeModal() {
            modal.classList.remove('active');
        }

        resetBtn.addEventListener('click', openModal);
        cancelBtn.addEventListener('click', closeModal);

        confirmBtn.addEventListener('click', async function() {
            const password = newPwd.value.trim();
            const confirm = confirmPwd.value.trim();

            if (!password || !confirm) {
                showError('Оба поля обязательны для заполнения.');
                return;
            }
            if (password !== confirm) {
                showError('Пароли не совпадают.');
                return;
            }
            if (password.length < 6) {
                showError('Пароль должен содержать не менее 6 символов.');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/Admin/ResetUserPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        userId: @Model.Id,
                        newPassword: password
                    })
                });

                const data = await response.json();
                if (response.ok) {
                    alert('Пароль успешно изменён.');
                    closeModal();
                } else {
                    showError(data.message || 'Ошибка при смене пароля.');
                }
            } catch (err) {
                showError('Ошибка сети. Попробуйте позже.');
            }
        });

        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
        });
    });
</script>

<style>
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    .modal-overlay.active {
        display: flex;
    }
    .modal-container {
        background: white;
        border-radius: 12px;
        width: 450px;
        max-width: 90%;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    .modal-header {
        padding: 1rem 1.5rem;
        background: #005baa;
        color: white;
        font-size: 1.25rem;
        font-weight: bold;
        border-radius: 12px 12px 0 0;
    }
    .modal-body {
        padding: 1.5rem;
    }
    .modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #dee2e6;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }
    .form-group {
        margin-bottom: 1rem;
    }
    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.5rem;
    }
</style>