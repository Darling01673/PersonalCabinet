@model List<PersonalCabinet.Models.User>
@{
    ViewData["Title"] = "Пользователи";
}
<link rel="stylesheet" href="/css/mainmenu.css" />

<div class="page">
    <div class="header">
        <h1><i class="bi bi-people"></i> Пользователи</h1>
    </div>

    <div class="card">
        <h2>Поиск</h2>
        <form method="get" class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Поиск (email, телефон)</label>
                <input type="text" name="searchString" class="form-control" value="@ViewBag.CurrentSearchString" placeholder="Введите email или телефон..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn-create w-100">Найти</button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a href="@Url.Action("Users")" class="btn-link-all w-100">Сбросить</a>
            </div>
        </form>
    </div>

    <div class="card">
        <h2>Список пользователей</h2>
        @if (Model.Any())
        {
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Email</th>
                                <th>Телефон</th>
                                <th>Тип</th>
                                <th>Роль</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var u in Model)
                        {
                                    <tr>
                                        <td>@u.Id</td>
                                        <td>@u.Email</td>
                                        <td>@u.Phone</td>
                                        <td>@u.UserType</td>
                                        <td>@u.Role</td>
                                        <td>
                                            <a href="@Url.Action("UserDetails", new { id = u.Id })" class="btn-small"><i class="bi bi-eye"></i> Детали</a>
                                        </td>
                                    </tr>
                        }
                        </tbody>
                    </table>
                </div>

            @if (ViewBag.TotalCount > ViewBag.PageSize)
            {
                        <div class="text-right" style="margin-top: 20px;">
                    @{
                        int totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize);
                        for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                                    <span class="btn-small disabled">@i</span>
                            }
                            else
                            {
                                                    <a href="@Url.Action("Users", new { page = i, searchString = ViewBag.CurrentSearchString })" class="btn-small">@i</a>
                            }
                        }
                    }
                        </div>
            }
        }
        else
        {
                <div class="empty">
                    <i class="bi bi-inbox"></i>
                    <p>Пользователи не найдены</p>
                </div>
        }
    </div>
</div>