@model List<PersonalCabinet.Models.Application>
@{
    ViewData["Title"] = "Управление заявками";
}
<div class="page-title"><i class="bi bi-file-earmark-text"></i> Все заявки</div>

<div class="card-cabinet mb-4">
    <div class="card-header">Фильтрация</div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label-cabinet">Статус</label>
               <select name="statusFilter" class="form-control-cabinet">
    <option value="">Все</option>
                    @foreach (var status in new[] { "Submitted", "InReview", "Approved", "Rejected", "Completed" })
                    {
                        string displayName = status switch
                        {
                            "Submitted" => "Подана",
                            "InReview" => "На рассмотрении",
                            "Approved" => "Одобрена",
                            "Rejected" => "Отклонена",
                            "Completed" => "Завершена",
                            _ => status
                        };
            <option value="@status" selected="@(ViewBag.CurrentStatusFilter == status)">@displayName</option>
                    }
</select>
            </div>
            <div class="col-md-5">
                <label class="form-label-cabinet">Поиск (№, название, адрес, email)</label>
                <input type="text" name="searchString" class="form-control-cabinet" value="@ViewBag.CurrentSearchString" />
            </div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn-cabinet w-100">Применить</button></div>
            <div class="col-md-2 d-flex align-items-end"><a href="@Url.Action("Index")" class="btn-cabinet-outline w-100">Сбросить</a></div>
        </form>
    </div>
</div>

<div class="card-cabinet">
    <div class="card-header">Список заявок</div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
                <table class="table-cabinet">
                    <thead>
                        <tr>
                            <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.NumberSortParam })">№ заявки ⇅</a></th>
                            <th>Название</th>
                            <th>Заявитель</th>
                            <th>Дата создания</th>
                            <th><a href="@Url.Action("Index", new { sortOrder = ViewBag.StatusSortParam })">Статус ⇅</a></th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var app in Model)
                    {
                                <tr>
                                    <td>@app.ApplicationNumber</td>
                                    <td>@app.Title</td>
                                    <td>@app.User.Email</td>
                                    <td>@app.CreatedAt?.ToString("dd.MM.yyyy")</td>
                                    <td>
                                @{
                                    string statusRu = app.Status switch
                                    {
                                        "Submitted" => "Подана",
                                        "InReview" => "На рассмотрении",
                                        "Approved" => "Одобрена",
                                        "Rejected" => "Отклонена",
                                        "Completed" => "Завершена",
                                        _ => app.Status
                                    };
                                }
                                        <span class="badge-status badge-@(app.Status.ToLower())">@statusRu</span>
                                     </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = app.Id })" class="btn-cabinet-outline btn-sm">Просмотр</a>
                                     </td>
                                </tr>
                    }
                    </tbody>
                </table>
                <div class="pagination-container">
                @for (int i = 1; i <= (int)Math.Ceiling((double)ViewBag.TotalCount / ViewBag.PageSize); i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                                    <span class="btn-cabinet-outline btn-sm disabled">@i</span>
                    }
                    else
                    {
                                    <a href="@Url.Action("Index", new { page = i, statusFilter = ViewBag.CurrentStatusFilter, searchString = ViewBag.CurrentSearchString, sortOrder = ViewBag.CurrentSort })" class="btn-cabinet-outline btn-sm">@i</a>
                    }
                }
                </div>
        }
        else
        {
                <div class="text-center p-5">Заявок нет</div>
        }
    </div>
</div>