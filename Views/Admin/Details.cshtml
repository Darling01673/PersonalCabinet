@model PersonalCabinet.Models.Application
@{
    ViewData["Title"] = "Заявка №" + Model.ApplicationNumber;
    string statusRu = Model.Status switch
    {
        "Draft" => "Черновик",
        "Submitted" => "Подана",
        "InReview" => "На рассмотрении",
        "Approved" => "Одобрена",
        "Rejected" => "Отклонена",
        "Completed" => "Завершена",
        _ => Model.Status
    };
}
<link rel="stylesheet" href="/css/details.css" />

<div class="page-title"><i class="bi bi-eye"></i> Заявка №@Model.ApplicationNumber</div>

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-md-7">
        <div class="card-cabinet">
            <div class="card-header">Данные заявки</div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-3 fw-bold">Статус:</div>
                    <div class="col-9">
                        <form method="post" asp-action="ChangeStatus" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="newStatus" class="form-select form-select-sm w-auto d-inline-block">
                                @foreach (var status in ViewBag.AllStatuses)
                                {
                                    string displayName = status switch
                                    {
                                        "Draft" => "Черновик",
                                        "Submitted" => "Подана",
                                        "InReview" => "На рассмотрении",
                                        "Approved" => "Одобрена",
                                        "Rejected" => "Отклонена",
                                        "Completed" => "Завершена",
                                        _ => status
                                    };
                                        <option value="@status" selected="@(status == Model.Status)">@displayName</option>
                                }
                            </select>
                            <button type="submit" class="btn-cabinet-outline btn-sm">Изменить</button>
                        </form>
                    </div>
                </div>
                <div class="row mb-2"><div class="col-3 fw-bold">Название:</div><div class="col-9">@Model.Title</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Причина обращения:</div><div class="col-9">@(Model.ApplicationReason ?? "—")</div></div>
                <hr />
                <div class="row mb-2"><div class="col-3 fw-bold">Энергопринимающее устройство:</div><div class="col-9">@(Model.EnergyDeviceName ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Адрес устройства:</div><div class="col-9">@(Model.DeviceAddress ?? Model.ObjectAddress)</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Запрашиваемая мощность:</div><div class="col-9">@(Model.RequestedPower?.ToString() ?? "—") кВт</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Ранее присоединённая мощность:</div><div class="col-9">@(Model.PreviousPowerKw?.ToString() ?? "—") кВт</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Общая присоединённая мощность:</div><div class="col-9">@(Model.TotalPowerKw?.ToString() ?? "—") кВт</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Категория надёжности:</div><div class="col-9">@(Model.ReliabilityCategory ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Сроки проектирования:</div><div class="col-9">@(Model.DesignDeadline?.ToString("dd.MM.yyyy") ?? "—")</div></div>
                <hr />
                <div class="row mb-2"><div class="col-3 fw-bold">Порядок оплаты:</div><div class="col-9">
                        @if (Model.PaymentPlan == "Option1")
                        {
                            <span>Вариант 1 (100% при получении счета)</span>
                        }
                        else if (Model.PaymentPlan == "Option2")
                        {
                            <span>Вариант 2 (10% при получении счета, 90% рассрочка до 3 лет)</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                </div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Гарантирующий поставщик:</div><div class="col-9">@(Model.GuarantyingSupplier ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Описание:</div><div class="col-9">@(Model.Description ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Дата подачи:</div><div class="col-9">@(Model.SubmittedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div></div>
                <div class="row mb-2"><div class="col-3 fw-bold">Заявитель (email):</div><div class="col-9">@Model.User.Email</div></div>
            </div>
        </div>
        <div class="card-cabinet mt-4">
            <div class="card-header">Документы</div>
            <div class="card-body">
                @if (Model.Documents.Any())
                {
                        <ul>
                        @foreach (var doc in Model.Documents)
                        {
                                    <li><a href="@doc.FilePath" target="_blank">@doc.OriginalFileName</a> (загружен @doc.UploadedAt?.ToString("dd.MM.yyyy"))</li>
                        }
                        </ul>
                }
                else
                {
                        <p>Нет документов</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card-cabinet">
            <div class="card-header">Данные заявителя</div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-4 fw-bold">Тип заявителя:</div>
                    <div class="col-8">
                        @(Model.ApplicantType == "INDIVIDUAL" ? "Физическое лицо" :
  Model.ApplicantType == "ENTREPRENEUR" ? "ИП" :
  Model.ApplicantType == "REPRESENTATIVE" ? "Представитель" :
  Model.ApplicantType == "ORGANIZATION" ? "Организация" : "—")
                    </div>
                </div>

                @((Model.ApplicantType == "INDIVIDUAL" || Model.ApplicantType == "ENTREPRENEUR" || Model.ApplicantType == "REPRESENTATIVE") ? "Физическое лицо" :
  Model.ApplicantType == "ORGANIZATION" ? "Организация" : "—")
                {
                        <div class="individual-fields">
                            <div class="row mb-2"><div class="col-4 fw-bold">ФИО:</div><div class="col-8">@($"{Model.LastName} {Model.FirstName} {Model.MiddleName}".Trim())</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Место жительства:</div><div class="col-8">@(Model.ResidenceAddress ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">СНИЛС:</div><div class="col-8">@(Model.SNILS?.ToString() ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Дата получения СНИЛС:</div><div class="col-8">@(Model.DateSNILS?.ToString("dd.MM.yyyy") ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Телефон:</div><div class="col-8">@(Model.Phone ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">ИНН:</div><div class="col-8">@(Model.Inn ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Паспорт:</div><div class="col-8">@(Model.PassportSeries) @(Model.PassportNumber)</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Дата выдачи:</div><div class="col-8">@(Model.PassportDate?.ToString("dd.MM.yyyy") ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Кем выдан:</div><div class="col-8">@(Model.PassportWhoIssued ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Адрес регистрации:</div><div class="col-8">@(Model.AddressRegistr ?? "—")</div></div>
                        </div>
                }
                else if (Model.ApplicantType == "ORGANIZATION")
                {
                        <div class="organization-fields">
                            <div class="row mb-2"><div class="col-4 fw-bold">Полное наименование:</div><div class="col-8">@(Model.OrganizationFullName ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Краткое наименование:</div><div class="col-8">@(Model.OrganizationShortName ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Контактное лицо:</div><div class="col-8">@(Model.ContactPerson ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">Телефон:</div><div class="col-8">@(Model.Phone ?? "—")</div></div>
                            <div class="row mb-2"><div class="col-4 fw-bold">ИНН:</div><div class="col-8">@(Model.Inn ?? "—")</div></div>
                        </div>
                }
                else
                {
                        <div class="row mb-2"><div class="col-12 text-muted">Данные заявителя отсутствуют</div></div>
                }
            </div>
        </div>

        <div class="card-cabinet mt-4">
            <div class="card-header"><i class="bi bi-chat-dots"></i> Чат с заявителем</div>
            <div class="card-body p-0">
                <div id="chat-window" style="display: flex; flex-direction: column; height: 495px;">
                    <div class="chat-messages" id="chat-messages">
                        @foreach (var msg in Model.Messages.OrderBy(m => m.CreatedAt))
                        {
                            string senderName = "Пользователь";
                            if (msg.Sender != null)
                            {
                                if (msg.Sender.Role == "Admin")
                                {
                                    senderName = "Администратор";
                                }
                                else if ((msg.Sender.UserType == "INDIVIDUAL" || msg.Sender.UserType == "ENTREPRENEUR" || msg.Sender.UserType == "REPRESENTATIVE")
&& msg.Sender.IndividualProfile != null)
                                    senderName = $"{msg.Sender.IndividualProfile.LastName} {msg.Sender.IndividualProfile.FirstName} {msg.Sender.IndividualProfile.MiddleName}".Trim();
                                else if (msg.Sender.UserType == "ORGANIZATION" && msg.Sender.OrganizationProfile != null)
                                    senderName = msg.Sender.OrganizationProfile.ShortName ?? msg.Sender.OrganizationProfile.FullName ?? msg.Sender.Email;
                                else
                                    senderName = msg.Sender.Email;
                            }
                                <div class="chat-message @(msg.SenderId == (long?)ViewBag.CurrentUserId ? "user" : "operator")">
                                    <p>@msg.Message1</p>
                                    <small>@senderName · @msg.CreatedAt?.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                        }
                    </div>
                    <div class="chat-input">
                        <div id="chat-file-preview" style="display: none; padding: 6px 12px; background: #f8f9fa; border-top: 1px solid #eee; font-size: 13px; align-items: center; justify-content: space-between; gap: 10px; width: 100%;">
                            <span id="chat-file-name" style="color: #495057; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                <i class="bi bi-paperclip"></i> <span></span>
                            </span>
                            <button type="button" id="btn-remove-file" style="border: none; background: none; color: #dc3545; font-weight: bold; cursor: pointer; font-size: 16px; padding: 0;">&times;</button>
                        </div>
                        <form id="chat-form">
                            @Html.AntiForgeryToken()
                            <button type="button" id="btn-attach" style="background: none; border: none; color: #6c757d; font-size: 1.25rem; cursor: pointer; padding: 0 8px;" title="Прикрепить файл">
                                <i class="bi bi-paperclip"></i>
                            </button>
                            <input type="file" id="chat-file" style="display: none;" />
                            <input type="text" id="chat-text" placeholder="Введите сообщение..." autocomplete="off" required />
                            <button type="submit"><i class="bi bi-send-fill"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2 mb-4">
    <a href="/Admin/Index" class="btn-cabinet-outline">Назад к списку</a>
    <a href="/Admin/Print/@Model.Id" class="btn-cabinet-outline" target="_blank">Создать отчёт</a>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const chatForm = document.getElementById('chat-form');
        const chatText = document.getElementById('chat-text');
        const messagesContainer = document.getElementById('chat-messages');
        const btnAttach = document.getElementById('btn-attach');
        const chatFile = document.getElementById('chat-file');
        const filePreview = document.getElementById('chat-file-preview');
        const fileNameSpan = document.querySelector('#chat-file-name span');
        const btnRemoveFile = document.getElementById('btn-remove-file');
        const applicationId = @Model.Id;

        function scrollToBottom() {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        scrollToBottom();

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        if (btnAttach) {
            btnAttach.addEventListener('click', function() {
                chatFile.click();
            });
        }

        if (chatFile) {
            chatFile.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    const file = this.files[0];
                    if (file.size > 10 * 1024 * 1024) {
                        alert("Файл не должен превышать 10 МБ.");
                        resetFile();
                        return;
                    }
                    fileNameSpan.textContent = file.name;
                    filePreview.style.display = 'flex';
                } else {
                    resetFile();
                }
            });
        }

        function resetFile() {
            if (chatFile) chatFile.value = '';
            if (filePreview) filePreview.style.display = 'none';
            if (fileNameSpan) fileNameSpan.textContent = '';
        }

        if (btnRemoveFile) {
            btnRemoveFile.addEventListener('click', resetFile);
        }
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        function addMessageToChat(data) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message ${data.isOwn ? 'user' : 'operator'}`;
            const date = new Date(data.createdAt);
            const timeStr = date.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            messageDiv.innerHTML = `<p>${escapeHtml(data.messageText)}</p><small>${escapeHtml(data.senderName)} · ${timeStr}</small>`;
            messagesContainer.appendChild(messageDiv);
            scrollToBottom();
        }

        connection.on("ReceiveMessage", (data) => {
            if (!data.isOwn) {
                addMessageToChat(data);
            }
        });

        function joinGroup() {
            connection.invoke("JoinApplicationGroup", applicationId)
                .catch(err => console.error("Ошибка подписки на группу чата:", err));
        }

        connection.start()
            .then(() => {
                console.log("SignalR подключён");
                joinGroup();
            })
            .catch(err => console.error("SignalR ошибка:", err));

        connection.onreconnected(() => {
            console.log("SignalR переподключён, восстанавливаем подписки");
            joinGroup();
        });
        chatForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const text = chatText.value.trim();
            const hasFile = chatFile && chatFile.files && chatFile.files.length > 0;

            if (!text && !hasFile) return;

            let finalMessage = text;

            if (hasFile) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('id', applicationId);
                formData.append('file', chatFile.files[0]);
                formData.append('__RequestVerificationToken', token);

                try {
                    const response = await fetch('/Application/AddDocument', {
                        method: 'POST',
                        body: formData
                    });
                    if (response.ok) {
                        const fileName = chatFile.files[0].name;
                        const fileNotification = `Добавлен документ: ${fileName}`;
                        finalMessage = finalMessage ? `${finalMessage}\n${fileNotification}` : fileNotification;
                        updateDocumentsUI(fileName);
                    } else {
                        alert('Ошибка загрузки документа на сервер.');
                        return;
                    }
                } catch (err) {
                    console.error("Ошибка при отправке файла:", err);
                    alert('Не удалось прикрепить файл.');
                    return;
                }
            }

            // Отправляем через SignalR
            try {
                await connection.invoke("SendMessage", applicationId, finalMessage);
                // Оптимистичное добавление своего сообщения (чтобы сразу видеть)
                const now = new Date();
                const timeStr = now.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                const messageDiv = document.createElement('div');
                messageDiv.className = 'chat-message user';
                messageDiv.innerHTML = `<p>${escapeHtml(finalMessage)}</p><small>Оператор · ${timeStr}</small>`;
                messagesContainer.appendChild(messageDiv);
                chatText.value = '';
                resetFile();
                scrollToBottom();
            } catch (err) {
                console.error("Ошибка отправки сообщения через SignalR:", err);
                alert('Не удалось отправить сообщение.');
            }
        });

        function updateDocumentsUI(fileName) {
            const docBlock = document.querySelector('.card-cabinet .card-body ul');
            if (!docBlock) return;
            const today = new Date().toLocaleDateString('ru-RU');
            const li = document.createElement('li');
            li.innerHTML = `<span>${escapeHtml(fileName)}</span> <small class="text-muted">(загружен сейчас, обновите страницу для скачивания)</small> (${today})`;
            docBlock.appendChild(li);
        }
    });
</script>