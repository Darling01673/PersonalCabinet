@{
    ViewData["Title"] = "Панель администратора";
    var latestApplications = ViewBag.LatestApplications as List<PersonalCabinet.Models.Application> ?? new List<PersonalCabinet.Models.Application>();
}
<link rel="stylesheet" href="/css/mainmenu.css" />

<div class="page">
    <div class="header">
        <h1>Панель администратора</h1>
        <p>Управление заявками, пользователями и обращениями</p>
    </div>

    <div class="stats">
        <a href="/Admin/Index?statusFilter=Submitted" class="stat-item" style="text-decoration: none; display: block;">
            <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
            <div class="stat-num">@ViewBag.SubmittedCount</div>
            <div class="stat-label">Требуют проверки</div>
        </a>
        <a href="/Admin/Index?statusFilter=InReview" class="stat-item" style="text-decoration: none; display: block;">
            <div class="stat-icon"><i class="bi bi-eye"></i></div>
            <div class="stat-num">@ViewBag.InReviewCount</div>
            <div class="stat-label">На рассмотрении</div>
        </a>
        <a href="/Admin/Messages" class="stat-item" style="text-decoration: none; display: block;">
            <div class="stat-icon"><i class="bi bi-chat-dots"></i></div>
            <div class="stat-num">@ViewBag.PendingMessagesCount</div>
            <div class="stat-label">Ждут ответа</div>
        </a>
    </div>
    <div class="card">
        <h2><i class="bi bi-file-earmark-text"></i> Последние заявки</h2>
        @if (latestApplications.Any())
        {
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th>№ заявки</th>
                                <th>Название</th>
                                <th>Заявитель</th>
                                <th>Дата создания</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var app in latestApplications)
                        {
                                    <tr>
                                        <td>@app.ApplicationNumber</td>
                                        <td>@app.Title</td>
                                        <td>@app.User?.Email</td>
                                        <td>@app.CreatedAt?.ToString("dd.MM.yyyy")</td>
                                        <td>
                                    @{
                                        string statusRu = app.Status switch
                                        {
                                            "Submitted" => "Подана",
                                            "InReview" => "На рассмотрении",
                                            "Approved" => "Одобрена",
                                            "Rejected" => "Отклонена",
                                            "Completed" => "Завершена",
                                            _ => app.Status
                                        };
                                        string badgeClass = app.Status switch
                                        {
                                            "Submitted" => "badge-yellow",
                                            "InReview" => "badge-blue",
                                            "Approved" => "badge-green",
                                            "Rejected" => "badge-red",
                                            "Completed" => "badge-green",
                                            _ => "badge-gray"
                                        };
                                    }
                                            <span class="badge @badgeClass">@statusRu</span>
                                        </td>
                                        <td>
                                            <a href="/Admin/Details/@app.Id" class="btn-small"><i class="bi bi-eye"></i> Просмотр</a>
                                        </td>
                                    </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="text-right" style="margin-top: 20px;">
                    <a href="/Admin/Index" class="btn-link-all">Все заявки →</a>
                </div>
        }
        else
        {
                <div class="empty">
                    <i class="bi bi-inbox"></i>
                    <p>Нет заявок</p>
                </div>
        }
    </div>
</div>