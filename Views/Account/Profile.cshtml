@model PersonalCabinet.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="page-title">
    <i class="bi bi-person-circle"></i> Мой профиль
</div>

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert-cabinet alert-cabinet-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card-cabinet">
    <div class="card-header">Личная информация</div>
    <div class="card-body">
        <form method="post" asp-action="Profile" id="profileForm">
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="UserType" value="@Model.UserType" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label-cabinet">Email</label>
                    <input type="email" name="Email" class="form-control-cabinet" value="@Model.Email" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label-cabinet">Телефон</label>
                    <input type="tel" name="Phone" class="form-control-cabinet" value="@Model.Phone" />
                </div>
            </div>

            @if (Model.UserType == "INDIVIDUAL")
            {
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label-cabinet">Фамилия</label>
                            <input type="text" name="LastName" class="form-control-cabinet" value="@Model.LastName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-cabinet">Имя</label>
                            <input type="text" name="FirstName" class="form-control-cabinet" value="@Model.FirstName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label-cabinet">Отчество</label>
                            <input type="text" name="MiddleName" class="form-control-cabinet" value="@Model.MiddleName" />
                        </div>
                    </div>

                    <hr />
                    <h5 class="mt-3 mb-3">Дополнительные персональные данные</h5>

                    <div class="mb-3">
                        <label class="form-label-cabinet">Место жительства</label>
                        <input type="text" name="ResidenceAddress" class="form-control-cabinet" value="@Model.ResidenceAddress" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-cabinet">ИНН</label>
                        <input type="text" name="Inn" class="form-control-cabinet" maxlength="12" value="@Model.Inn" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label-cabinet">Серия паспорта</label>
                            <input type="text" name="PassportSeries" class="form-control-cabinet" maxlength="4" value="@Model.PassportSeries" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-cabinet">Номер паспорта</label>
                            <input type="text" name="PassportNumber" class="form-control-cabinet" maxlength="6" value="@Model.PassportNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-cabinet">Дата выдачи</label>
                            <input type="date" name="PassportDate" class="form-control-cabinet" value="@(Model.PassportDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
            }
            @if (Model.UserType == "ORGANIZATION")
            {
                    <div class="mb-3">
                        <label class="form-label-cabinet">Полное наименование</label>
                        <input type="text" name="OrgFullName" class="form-control-cabinet" value="@Model.OrgFullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-cabinet">Сокращённое наименование</label>
                        <input type="text" name="OrgShortName" class="form-control-cabinet" value="@Model.OrgShortName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-cabinet">Контактное лицо</label>
                        <input type="text" name="ContactPerson" class="form-control-cabinet" value="@Model.ContactPerson" />
                    </div>
            }

            <div class="mt-3">
                <button type="button" class="btn-cabinet" data-bs-toggle="modal" data-bs-target="#confirmSaveModal">
                    <i class="bi bi-save"></i> Сохранить изменения
                </button>
                <a href="/Home/MainMenu" class="btn-cabinet-outline">Назад</a>
            </div>
        </form>

        <hr class="mt-4" />
        <div class="mt-3">
            <h5>Смена пароля</h5>
            <p><a href="/Account/ChangePassword" class="btn-cabinet-outline">Изменить пароль</a></p>
        </div>
    </div>
</div>
<div class="modal fade" id="confirmSaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Подтверждение сохранения</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Вы действительно хотите сохранить изменения в профиле?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cabinet-outline" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn-cabinet" id="confirmSaveBtn">Да, сохранить</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('confirmSaveBtn').addEventListener('click', function() {
        document.getElementById('profileForm').submit();
    });
</script>