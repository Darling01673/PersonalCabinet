@model PersonalCabinet.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Мой профиль";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мой профиль – Личный кабинет</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/mainmenu.css" />
    <link rel="stylesheet" href="/css/account-forms.css" />
</head>
<body>
<div class="page">
    <div class="card">
        <h2><i class="bi bi-person-circle"></i> Мой профиль</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-error">@TempData["ErrorMessage"]</div>
            }

        <form method="post" asp-action="Profile" id="profileForm">
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="UserType" value="@Model.UserType" />

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Телефон</label>
                    <input type="tel" name="Phone" class="form-control" value="@Model.Phone" />
                </div>
            </div>

                @if (Model.UserType == "INDIVIDUAL")
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Фамилия</label>
                            <input type="text" name="LastName" class="form-control" value="@Model.LastName" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Имя</label>
                            <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Отчество</label>
                            <input type="text" name="MiddleName" class="form-control" value="@Model.MiddleName" />
                        </div>
                    </div>

                    <hr class="divider" />

                    <div class="subsection-title">
                        <i class="bi bi-person-badge"></i> Дополнительные персональные данные
                    </div>

                    <div class="form-group">
                        <label class="form-label">Место жительства</label>
                        <input type="text" name="ResidenceAddress" class="form-control" value="@Model.ResidenceAddress" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">ИНН</label>
                        <input type="text" name="Inn" class="form-control" maxlength="12" value="@Model.Inn" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Серия паспорта</label>
                            <input type="text" name="PassportSeries" class="form-control" maxlength="4" value="@Model.PassportSeries" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Номер паспорта</label>
                            <input type="text" name="PassportNumber" class="form-control" maxlength="6" value="@Model.PassportNumber" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Дата выдачи</label>
                            <input type="date" name="PassportDate" class="form-control" value="@(Model.PassportDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                }

                @if (Model.UserType == "ORGANIZATION")
                {
                    <div class="form-group">
                        <label class="form-label">Полное наименование</label>
                        <input type="text" name="OrgFullName" class="form-control" value="@Model.OrgFullName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Сокращённое наименование</label>
                        <input type="text" name="OrgShortName" class="form-control" value="@Model.OrgShortName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Контактное лицо</label>
                        <input type="text" name="ContactPerson" class="form-control" value="@Model.ContactPerson" />
                    </div>
                }

            <div class="form-actions">
                <button type="button" class="btn-exit" id="saveProfileBtn">
                    <i class="bi bi-save"></i> Сохранить изменения
                </button>
                <a href="/Home/MainMenu" class="btn-small">Назад</a>
            </div>
        </form>

        <hr class="divider" />

        <div>
            <div class="subsection-title">
                <i class="bi bi-shield-lock"></i> Смена пароля
            </div>
            <a href="/Account/ChangePassword" class="btn-small">Изменить пароль</a>
        </div>
    </div>
</div>
<div id="saveModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
           Подтверждение сохранения
        </div>
        <div class="modal-body">
            Вы действительно хотите сохранить изменения в профиле?
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-small" id="modalCancelBtn">Отмена</button>
            <button type="button" class="btn-exit" id="modalConfirmBtn">Да, сохранить</button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('saveModal');
    const saveBtn = document.getElementById('saveProfileBtn');
    const confirmBtn = document.getElementById('modalConfirmBtn');
    const cancelBtn = document.getElementById('modalCancelBtn');
    const form = document.getElementById('profileForm');

    saveBtn.addEventListener('click', () => modal.classList.add('active'));
    cancelBtn.addEventListener('click', () => modal.classList.remove('active'));
    confirmBtn.addEventListener('click', () => form.submit());
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('active'); });
</script>
</body>
</html>