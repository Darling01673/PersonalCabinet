@model PersonalCabinet.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Вход";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>АО «ГНЦ НИИАР» — Вход</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/login.css" />
</head>
<body>
<div class="login-page">
    <div class="login-box">
        <div class="login-header">
            <h1>Вход</h1>
            <p>Личный кабинет технологического присоединения</p>
        </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert error">@ViewBag.Error</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert error">@TempData["ErrorMessage"]</div>
            }

        <form method="post" asp-action="Login">
                @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert error"></div>

            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Пароль</label>
                <input type="password" name="Password" class="form-control" required />
            </div>
            <div class="form-check">
                <input asp-for="RememberMe" class="check-input" />
                <label asp-for="RememberMe" class="check-label">Запомнить меня</label>
            </div>

            <button type="submit" class="btn-submit">
                <i class="bi bi-box-arrow-in-right"></i> Войти
            </button>
        </form>
        <div class="login-footer" style="margin-top: 15px;">
            <a href="/Home/Index" class="btn-home">
                <i class="bi bi-house-door"></i> На главную
            </a>
        </div>

        <div class="login-footer">
            Нет аккаунта? <a href="/Account/Register">Зарегистрироваться</a>
        </div>
    </div>
</div>
</body>
</html>