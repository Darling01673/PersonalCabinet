@model PersonalCabinet.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Смена пароля – Личный кабинет</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/mainmenu.css" />
    <link rel="stylesheet" href="/css/account-forms.css" />
</head>
<body>
<div class="page">
    <div class="card">
        <h2><i class="bi bi-key"></i> Смена пароля</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-error">@TempData["ErrorMessage"]</div>
            }

        <form method="post" asp-action="ChangePassword" id="changePasswordForm">
            <div class="form-group">
                <label class="form-label">Текущий пароль</label>
                <input type="password" name="CurrentPassword" class="form-control" id="CurrentPassword" />
            </div>
            <div class="form-group">
                <label class="form-label">Новый пароль</label>
                <div style="display:flex; gap:8px">
                    <input type="password" name="NewPassword" class="form-control" id="NewPassword" style="flex:1" />
                    <button type="button" class="btn-small" onclick="togglePassword('NewPassword')">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Подтверждение пароля</label>
                <div style="display:flex; gap:8px">
                    <input type="password" name="ConfirmPassword" class="form-control" id="ConfirmPassword" style="flex:1" />
                    <button type="button" class="btn-small" onclick="togglePassword('ConfirmPassword')">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-exit" id="changePasswordBtn">
                    <i class="bi bi-shield-lock"></i> Изменить пароль
                </button>
                <a href="/Account/Profile" class="btn-small">Отмена</a>
            </div>
        </form>
    </div>
</div>
<div id="confirmPasswordModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <i class="bi bi-question-circle"></i> Подтверждение смены пароля
        </div>
        <div class="modal-body">
            Вы действительно хотите изменить пароль?
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-small" id="cancelPasswordBtn">Отмена</button>
            <button type="button" class="btn-exit" id="confirmPasswordBtn">Да, изменить</button>
        </div>
    </div>
</div>
<div id="errorModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header" style="background:#dc3545">
           Ошибка
        </div>
        <div class="modal-body" id="errorMessageText">
            Заполните все поля и убедитесь, что пароли совпадают.
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-exit" id="errorModalCloseBtn" style="background:#dc3545; border-color:#dc3545">OK</button>
        </div>
    </div>
</div>

<script>
    function togglePassword(fieldId) {
        var field = document.getElementById(fieldId);
        field.type = field.type === "password" ? "text" : "password";
    }

    const current = document.getElementById('CurrentPassword');
    const newPwd = document.getElementById('NewPassword');
    const confirmPwd = document.getElementById('ConfirmPassword');

    function showError(message) {
        document.getElementById('errorMessageText').innerText = message;
        document.getElementById('errorModal').classList.add('active');
    }

    function validateForm() {
        let ok = true;
        [current, newPwd, confirmPwd].forEach(f => f.classList.remove('is-invalid'));

        if (!current.value.trim()) {
            current.classList.add('is-invalid');
            ok = false;
        }
        if (!newPwd.value.trim()) {
            newPwd.classList.add('is-invalid');
            ok = false;
        }
        if (!confirmPwd.value.trim()) {
            confirmPwd.classList.add('is-invalid');
            ok = false;
        } else if (newPwd.value.trim() !== confirmPwd.value.trim()) {
            confirmPwd.classList.add('is-invalid');
            ok = false;
        }

        if (!ok) {
            showError('Заполните все поля и убедитесь, что пароли совпадают.');
        }
        return ok;
    }

    const confirmModal = document.getElementById('confirmPasswordModal');
    const errorModal = document.getElementById('errorModal');
    const changeBtn = document.getElementById('changePasswordBtn');
    const confirmBtn = document.getElementById('confirmPasswordBtn');
    const cancelBtn = document.getElementById('cancelPasswordBtn');
    const errorClose = document.getElementById('errorModalCloseBtn');
    const form = document.getElementById('changePasswordForm');

    changeBtn.addEventListener('click', () => {
        if (validateForm()) {
            confirmModal.classList.add('active');
        }
    });

    cancelBtn.addEventListener('click', () => confirmModal.classList.remove('active'));
    confirmBtn.addEventListener('click', () => form.submit());
    errorClose.addEventListener('click', () => errorModal.classList.remove('active'));
    [confirmModal, errorModal].forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.classList.remove('active');
        });
    });
</script>
</body>
</html>