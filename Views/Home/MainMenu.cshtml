@{
    ViewData["Title"] = "Главная";
    var user = ViewBag.User as PersonalCabinet.Models.User;
    var applications = (ViewBag.UserApplications as List<PersonalCabinet.Models.Application>) ?? new List<PersonalCabinet.Models.Application>();
}
<link rel="stylesheet" href="/css/mainmenu.css" />

@if (user == null)
{
    <div class="alert alert-warning" style="background: #fff3cd; color: #856404; border-left: 4px solid #ffc107; padding: 20px; border-radius: 8px; text-align: center;">
        <i class="bi bi-exclamation-triangle-fill" style="font-size: 24px;"></i>
        <h4>Доступ ограничен</h4>
        <p>Пожалуйста, <a href="/Account/Login" style="font-weight: 600;">войдите в систему</a>, чтобы просматривать содержимое личного кабинета.</p>
    </div>
}
else
{
    <div class="page-title">
        <i class="bi bi-house-door"></i> Главная страница
    </div>
    <div class="card-cabinet mb-4">
        <div class="card-body">
            <h3 style="color: var(--blue-dark); margin-bottom: 10px;">
                Добро пожаловать,
                @if (user.UserType == "ORGANIZATION")
                {
                    @(user.OrganizationProfile?.ShortName ?? user.OrganizationProfile?.FullName ?? "Организация")
                }
                else
                {
                    @($"{user.IndividualProfile?.LastName} {user.IndividualProfile?.FirstName} {user.IndividualProfile?.MiddleName}".Trim())
                }
                !
            </h3>
            <p style="color: #666; margin: 0;">Личный кабинет для технологического присоединения к электрическим сетям</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-card-blue">
                <div class="stat-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@applications.Count</div>
                    <div class="stat-label">Всего заявок</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-green">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@applications.Count(a => a.Status == "Approved")</div>
                    <div class="stat-label">Одобрено</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-orange">
                <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@applications.Count(a => a.Status == "InReview")</div>
                    <div class="stat-label">На рассмотрении</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-cabinet mb-4">
        <div class="card-header">
            <i class="bi bi-file-earmark-text"></i> Последние заявки
        </div>
        <div class="card-body p-0">
            @if (applications.Any())
            {
                <table class="table-cabinet">
                    <thead>
                        <tr>
                            <th>№ заявки</th>
                            <th>Название</th>
                            <th>Дата подачи</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in applications)
                        {
                            <tr>
                                <td>@app.ApplicationNumber</td>
                                <td>@app.Title</td>
                                <td>@(app.CreatedAt?.ToString("dd.MM.yyyy") ?? "")</td>
                                <td>
                                    @switch (app.Status)
                                    {
                                        case "Draft":
                                        case "NEW":
                                            <span class="badge-status badge-draft">Черновик</span>
                                            break;
                                        case "Submitted":
                                            <span class="badge-status badge-submitted">Подана</span>
                                            break;
                                        case "InReview":
                                        case "IN_REVIEW":
                                            <span class="badge-status badge-inreview">На рассмотрении</span>
                                            break;
                                        case "Approved":
                                        case "APPROVED":
                                            <span class="badge-status badge-approved">Одобрена</span>
                                            break;
                                        case "Rejected":
                                        case "REJECTED":
                                            <span class="badge-status badge-rejected">Отклонена</span>
                                            break;
                                        case "Completed":
                                        case "COMPLETED":
                                            <span class="badge-status badge-submitted">Завершена</span>
                                            break;
                                        default:
                                            <span class="badge-status badge-draft">@app.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a href="/Application/Details/@app.Id" class="btn-cabinet-outline btn-sm"><i class="bi bi-eye"></i> Просмотр</a>
                                    @if (app.Status == "Draft" || app.Status == "NEW" || app.Status == "Rejected" || app.Status == "REJECTED")
                                    {
                                        <a href="/Application/Edit/@app.Id" class="btn-cabinet-outline btn-sm"><i class="bi bi-pencil"></i> Редактировать</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="padding: 30px; text-align: center; color: #999;">
                    <i class="bi bi-inbox" style="font-size: 48px; display: block; margin-bottom: 10px;"></i>
                    <p>У вас пока нет заявок</p>
                    <a href="/Application/Create" class="btn-cabinet mt-2"><i class="bi bi-plus-circle"></i> Подать первую заявку</a>
                </div>
            }
        </div>
        @if (applications.Any())
        {
            <div class="card-body" style="border-top: 1px solid #e3eaf5;">
                <a href="/Application/Index" class="btn-cabinet-outline"><i class="bi bi-arrow-right"></i> Все заявки</a>
            </div>
        }
    </div>
}