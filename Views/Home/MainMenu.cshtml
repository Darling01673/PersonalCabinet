@{
    ViewData["Title"] = "Личный кабинет";
    var user = ViewBag.User as PersonalCabinet.Models.User;
    var applications = (ViewBag.UserApplications as List<PersonalCabinet.Models.Application>) ?? new List<PersonalCabinet.Models.Application>();
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>АО «ГНЦ НИИАР» — Личный кабинет</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/mainmenu.css" />
</head>
<body>
<div class="page">
            <div class="card">
                <h2><i class="bi bi-person-circle"></i> Добро пожаловать</h2>
                <p class="welcome-name">
                    @if (user.UserType == "ORGANIZATION")
                    {
                        @(user.OrganizationProfile?.ShortName ?? user.OrganizationProfile?.FullName ?? "Организация")
                    }
                    else
                    {
                        @($"{user.IndividualProfile?.LastName} {user.IndividualProfile?.FirstName} {user.IndividualProfile?.MiddleName}".Trim())
                    }
                </p>
                <p>Личный кабинет для технологического присоединения к электрическим сетям</p>
            </div>

            <div class="stats">
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-file-earmark-text"></i></div>
                    <div class="stat-num">@applications.Count</div>
                    <div class="stat-label">Всего заявок</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                    <div class="stat-num">@applications.Count(a => a.Status == "Approved")</div>
                    <div class="stat-label">Одобрено</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                    <div class="stat-num">@applications.Count(a => a.Status == "InReview")</div>
                    <div class="stat-label">На рассмотрении</div>
                </div>
            </div>

            <div class="card">
                <h2><i class="bi bi-file-earmark-text"></i> Последние заявки</h2>
                @if (applications.Any())
                {
                        <div class="table-responsive">
                            <table class="app-table">
                                <thead>
                                    <tr>
                                        <th>№ заявки</th>
                                        <th>Название</th>
                                        <th>Дата</th>
                                        <th>Статус</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var app in applications.Take(5))
                                {
                                            <tr>
                                                <td>@app.ApplicationNumber</td>
                                                <td>@app.Title</td>
                                                <td>@(app.CreatedAt?.ToString("dd.MM.yyyy") ?? "")</td>
                                                <td>
                                            @{
                                                string badge = "badge-gray";
                                                string statusText = app.Status;
                                                if (app.Status == "Draft" || app.Status == "NEW") { badge = "badge-gray"; statusText = "Черновик"; }
                                                else if (app.Status == "Submitted") { badge = "badge-yellow"; statusText = "Подана"; }
                                                else if (app.Status == "InReview" || app.Status == "IN_REVIEW") { badge = "badge-blue"; statusText = "На рассмотрении"; }
                                                else if (app.Status == "Approved" || app.Status == "APPROVED") { badge = "badge-green"; statusText = "Одобрена"; }
                                                else if (app.Status == "Rejected" || app.Status == "REJECTED") { badge = "badge-red"; statusText = "Отклонена"; }
                                                else if (app.Status == "Completed" || app.Status == "COMPLETED") { badge = "badge-green"; statusText = "Завершена"; }
                                            }
                                                    <span class="badge @badge">@statusText</span>
                                                </td>
                                                <td>
                                                    <a href="/Application/Details/@app.Id" class="btn-small"><i class="bi bi-eye"></i> Просмотр</a>
                                            @if (app.Status == "Draft" || app.Status == "NEW" || app.Status == "Rejected" || app.Status == "REJECTED")
                                            {
                                                            <a href="/Application/Edit/@app.Id" class="btn-small"><i class="bi bi-pencil"></i> Ред.</a>
                                            }
                                                </td>
                                            </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-right">
                            <a href="/Application/Index" class="btn-link-all">Все заявки <i class="bi bi-arrow-right"></i></a>
                        </div>
                }
                else
                {
                        <div class="empty">
                            <i class="bi bi-inbox"></i>
                            <p>У вас пока нет заявок</p>
                            <a href="/Application/Create" class="btn-create"><i class="bi bi-plus-circle"></i> Подать первую заявку</a>
                        </div>
                }
            </div>    
</div>
</body>
</html>