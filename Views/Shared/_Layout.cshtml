@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Личный кабинет</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    @if (User.Identity.IsAuthenticated)
    {
        var userName = User.Identity.Name ?? "Пользователь";

            <header class="top-navbar">
                <div class="top-navbar__left">
                    <a href="/Home/Index" class="top-navbar__logo">
                        <img src="~/images/logo.png" alt="Логотип" height="38" onerror="this.style.display='none'" />
                        <span class="top-navbar__logo-text">Сетевая организация</span>
                    </a>
                </div>
                <div class="top-navbar__right">
                @{
                    int unreadCount = 0;
                    if (User.Identity.IsAuthenticated)
                    {
                        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
                        if (long.TryParse(userIdClaim, out long userId))
                        {
                            if (User.IsInRole("Admin"))
                            {
                                unreadCount = DbContext.Messages.Count(m => m.IsRead == false && m.Sender.Role != "Admin");
                            }
                            else
                            {
                                unreadCount = (from m in DbContext.Messages
                                               join a in DbContext.Applications on m.ApplicationId equals a.Id
                                               where m.IsRead == false && m.SenderId != userId && a.UserId == userId
                                               select m).Count();
                            }
                        }
                    }
                }
                    <a href="@(User.IsInRole("Admin") ? "/Admin/Messages" : "/Messages/Index")" class="nav-icon-btn me-2" title="Сообщения">
                        <i class="bi bi-envelope-fill" style="font-size: 1.4rem;"></i>
                    @if (unreadCount > 0)
                    {
                                <span class="notification-badge">@unreadCount</span>
                    }
                    </a>
                    <div class="top-navbar__profile dropdown">
                        <a href="#" class="nav-icon-btn dropdown-toggle" data-bs-toggle="dropdown" title="Профиль">
                            <i class="bi bi-person-circle"></i>
                            <span class="profile-name">@userName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i>Мой профиль</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Выйти</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="main-wrapper">
                <aside class="sidebar">
                    <nav class="sidebar__nav">
                        <ul class="sidebar__menu">
                        @if (User.IsInRole("Admin"))
                        {
                                    <li class="sidebar__item"><a href="/Admin/MainMenuAdmin" class="sidebar__link"><i class="bi bi-grid"></i><span>Главная</span></a></li>
                                    <li class="sidebar__item"><a href="/Admin/Index" class="sidebar__link"><i class="bi bi-grid"></i><span>Все заявки</span></a></li>
                                    <li class="sidebar__item"><a href="/Admin/Users" class="sidebar__link"><i class="bi bi-people"></i><span>Пользователи</span></a></li>
                                    <li class="sidebar__item"><a href="/Admin/Messages" class="sidebar__link"><i class="bi bi-chat-dots"></i><span>Обращения</span></a></li>
                        }
                        else
                        {
                                    <li class="sidebar__item"><a href="/Home/MainMenu" class="sidebar__link"><i class="bi bi-house-door"></i><span>Главная</span></a></li>
                                    <li class="sidebar__item"><a href="/Application/Index" class="sidebar__link"><i class="bi bi-file-earmark-text"></i><span>Мои заявки</span></a></li>
                                    <li class="sidebar__item"><a href="/Application/Create" class="sidebar__link"><i class="bi bi-plus-circle"></i><span>Подать заявку</span></a></li>
                                    <li class="sidebar__item"><a href="/Messages/Index" class="sidebar__link"><i class="bi bi-chat-dots"></i><span>Сообщения</span></a></li>
                                    <li class="sidebar__item"><a href="/Account/Profile" class="sidebar__link"><i class="bi bi-person"></i><span>Профиль</span></a></li>
                        }
                        </ul>
                    </nav>
                </aside>
                <main class="content-area">
                @RenderBody()
                </main>
            </div>
    }
    else
    {
            <main class="content-fullwidth">
            @RenderBody()
            </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        function updateNotificationBadge() {
            fetch('/Account/GetUnreadCount')
                .then(response => response.json())
                .then(data => {
                    const envelopeLink = document.querySelector('.nav-icon-btn[title="Сообщения"]');
                    if (!envelopeLink) return;
                    let badge = envelopeLink.querySelector('.notification-badge');
                    if (data > 0) {
                        if (badge) {
                            badge.textContent = data;
                        } else {
                            badge = document.createElement('span');
                            badge.className = 'notification-badge';
                            badge.textContent = data;
                            envelopeLink.appendChild(badge);
                        }
                    } else {
                        if (badge) badge.remove();
                    }
                })
                .catch(err => console.error('Ошибка обновления уведомлений:', err));
        }

        connection.start()
            .then(() => {
                console.log("SignalR подключён");
                return connection.invoke("SubscribeToNotifications");
            })
            .then(() => {
                console.log("Подписан на уведомления");
            })
            .catch(err => console.error("Ошибка SignalR:", err));

        connection.on("UpdateNotificationCount", () => {
            updateNotificationBadge();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>